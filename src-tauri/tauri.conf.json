{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Threadcap",
  "version": "0.8.4",
  "identifier": "app.vibeisland.windows",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node scripts/build/codex-bridge.cjs",
    "beforeBuildCommand": "node scripts/build/codex-bridge.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Threadcap",
        "width": 592,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/vibe-island-codex"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
