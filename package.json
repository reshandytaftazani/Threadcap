{
  "name": "threadcap",
  "version": "0.8.4",
  "description": "Dynamic Island for AI coding agents on Windows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reshandytaftazani/Threadcap.git"
  },
  "homepage": "https://github.com/reshandytaftazani/Threadcap#readme",
  "bugs": {
    "url": "https://github.com/reshandytaftazani/Threadcap/issues"
  },
  "main": "src/index.html",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "preview": "python -m http.server 4173 --bind 127.0.0.1 --directory src",
    "test": "node --test tests/unit/session-model.test.cjs tests/unit/presentation-policy.test.cjs tests/unit/usage.test.cjs && cargo test --locked --manifest-path crates/island-core/Cargo.toml",
    "test:core": "cargo test --manifest-path crates/island-core/Cargo.toml",
    "test:bridge": "cargo test --locked --manifest-path crates/codex-bridge/Cargo.toml -- --test-threads=1",
    "test:native": "node scripts/build/codex-bridge.cjs && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:sessions": "node tests/native/check-threadcap-native.cjs",
    "test:session-opening": "node tests/native/check-session-opening-native.cjs",
    "test:agent-icons": "node tests/native/check-agent-companions-native.cjs",
    "test:antigravity-exit": "node tests/native/check-antigravity-exit-native.cjs",
    "test:observer-upgrade": "node tests/native/check-observer-upgrade-native.cjs",
    "test:antigravity-usage": "node tests/native/check-antigravity-usage-native.cjs",
    "test:opencode-plugin": "node tests/native/check-opencode-plugin.cjs",
    "test:opencode-questions": "node tests/native/check-opencode-questions-native.cjs",
    "test:opencode-replies": "node tests/native/check-opencode-replies-native.cjs",
    "test:opencode-lifetime": "node tests/native/check-opencode-lifetime-native.cjs",
    "check:publication": "node scripts/verify-publication.cjs",
    "build:bridge": "node scripts/build/codex-bridge.cjs",
    "icons:build": "tauri icon src/assets/island-app.svg --output src-tauri/icons",
    "release:stage": "node scripts/release/stage.cjs",
    "watch:antigravity": "powershell -ExecutionPolicy Bypass -File integrations/antigravity/watch.ps1",
    "test:legacy": "python -m unittest discover -s tests/legacy -p test_*.py",
    "legacy:bridge": "python legacy/bridge/antigravity_bridge.py",
    "legacy:desktop": "powershell -ExecutionPolicy Bypass -File legacy/desktop/launch-island.ps1",
    "start": "tauri dev",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "keywords": [
    "dynamic-island",
    "ai-agents",
    "antigravity",
    "opencode",
    "codex",
    "windows",
    "threadcap"
  ],
  "author": "Threadcap contributors",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
